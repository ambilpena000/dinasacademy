# ── Template .env untuk server production (docker compose) ─────
# Di server, salin menjadi .env lalu isi SEMUA nilainya:
#   cp env.example .env && nano .env
#
# Backend MENOLAK start jika JWT_SECRET / DB_PASSWORD masih bawaan/lemah
# atau FRONTEND_URL masih localhost.
#
# Buat string acak:  openssl rand -hex 48

# Domain website (tanpa https://, tanpa www)
DOMAIN=dinasacademy.com
FRONTEND_URL=https://dinasacademy.com
VITE_API_URL=https://dinasacademy.com/api

# Database (container postgres)
DB_USERNAME=postgres
DB_PASSWORD=ISI_PASSWORD_DATABASE_YANG_KUAT
DB_NAME=dinasacademy

# JWT — minimal 32 karakter acak (openssl rand -hex 48)
JWT_SECRET=ISI_DENGAN_HASIL_OPENSSL_RAND
JWT_EXPIRES_IN=7d

# Email untuk reset password (opsional, mis. Brevo / Gmail App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
