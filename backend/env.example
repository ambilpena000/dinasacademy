# ── Database PostgreSQL ──────────────────────────
# Pilih SALAH SATU:
#  (a) Database online (Neon/Supabase) — isi connection string, SSL otomatis aktif:
# DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#  (b) PostgreSQL lokal / VPS:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
